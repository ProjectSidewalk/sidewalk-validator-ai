  "venv-api/bin/python analysis/serving_parity.py api-worker --api-dir <api> --depth-checkpoint depth_anything_v2_metric_vkitti_vitb.pth --train-dir WORK/train --pano-npy WORK/train/pano_bgr.npy --out WORK/api_xfeed",
  ".venv/bin/python analysis/serving_parity.py isolate --train WORK/train --api WORK/api_xfeed --out docs/serving-parity-2026-10/isolation.txt",
  "venv-klone/bin/python analysis/serving_parity.py pixel-probe --pano sample_pano.jpg --crops WORK/train/*/crop_raw.png --crops-root WORK/train --out P_klone",
  "venv-api/bin/python analysis/serving_parity.py pixel-probe --pano sample_pano.jpg --reference-decode P_klone/decode.npy --crops WORK/train/*/crop_raw.png --crops-root WORK/train --out P_api",
  ".venv/bin/python analysis/serving_parity.py pixel-compare P_klone P_api --out docs/serving-parity-2026-10/pixel_probe.txt",
  ".venv/bin/python analysis/serving_parity.py compare --train WORK/train --train-other WORK/train_other1 --api WORK/api --api-dir <api> --out WORK/out --append docs/serving-parity-2026-10/isolation.txt docs/serving-parity-2026-10/pixel_probe.txt",
